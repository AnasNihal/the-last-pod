#!/bin/sh
set -eu

expected_name='Ahammed Anas Nihal'
expected_email='108085694+AnasNihal@users.noreply.github.com'
actual_name="$(git config user.name || true)"
actual_email="$(git config user.email || true)"
remote_name="${1:-}"
remote_url="${2:-}"

if [ "$actual_name" != "$expected_name" ] || [ "$actual_email" != "$expected_email" ]; then
  echo "Push blocked: Git identity must be $expected_name <$expected_email>." >&2
  echo "Current identity: $actual_name <$actual_email>" >&2
  exit 1
fi

case "$remote_url" in
  https://github.com/AnasNihal/the-last-pod.git|git@github.com:AnasNihal/the-last-pod.git)
    ;;
  *)
    echo "Push blocked: $remote_name does not point to AnasNihal/the-last-pod." >&2
    echo "Remote URL: $remote_url" >&2
    exit 1
    ;;
esac
